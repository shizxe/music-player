<?php
declare(strict_types=1);

namespace App\Services\{{ module }};

use App\Repositories\{{ module }}\{{ model }}RepositoryInterface;

class {{ model }}Service implements {{ model }}ServiceInterface
{
    public function __construct(private {{ model }}RepositoryInterface $repository) {}

    public function get(array $data = []): array
    {
        return $this->repository->get($data);
    }

    public function create(array $data): array
    {
        return $this->repository->create($data);
    }

    public function update(int $id, array $data): array
    {
        return $this->repository->update($id, $data);
    }

    public function delete(int $id): void
    {
        $this->repository->delete($id);
    }
}
